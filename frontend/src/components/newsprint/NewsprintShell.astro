---
import { issueLabel, issueNumber } from '../../lib/issue.js';

interface Props {
  locale: 'en' | 'ko';
  masthead?: string;
  editionLabel?: string;
  subkicker?: string[];
  publishedAt?: string;
  rail?: boolean;
  compact?: boolean;
  backHref?: string;
  backLabel?: string;
  /** compact only: shown instead of the issue/date, joined with ' · ' (e.g. handbook fields) */
  crumbItems?: string[];
}

const { locale, masthead = '', editionLabel, subkicker, publishedAt, rail = true, compact = false, backHref, backLabel, crumbItems } = Astro.props;
const isKo = locale === 'ko';
const nonce = Astro.locals.cspNonce || '';
const displayDate = publishedAt ? new Date(publishedAt) : new Date();
const browserLocale = isKo ? 'ko-KR' : 'en-US';
const browserDateIso = displayDate.toISOString();
const dateLabel = isKo
  ? displayDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })
  : displayDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<section class="newsprint-page">
  {compact ? (
    <nav class="newsprint-crumb" aria-label={isKo ? '위치' : 'Breadcrumb'}>
      <a href={backHref ?? `/${locale}/news/`}>← {backLabel ?? (isKo ? 'AI 뉴스' : 'AI News')}</a>
      {crumbItems ? (
        crumbItems.length > 0 && <span class="newsprint-crumb-items">{crumbItems.join(' · ')}</span>
      ) : (
        <>
          <span>{issueLabel(locale, issueNumber(displayDate))}</span>
          <span data-local-date data-date-iso={browserDateIso} data-date-locale={browserLocale}>{dateLabel}</span>
        </>
      )}
    </nav>
  ) : (
    <header class="newsprint-header">
      <div class="newsprint-kicker">
        <span>{issueLabel(locale, issueNumber(displayDate))}</span>
        <span>{editionLabel ?? (isKo ? 'AI 뉴스 데일리' : 'AI Daily Dispatch')}</span>
        <span data-local-date data-date-iso={browserDateIso} data-date-locale={browserLocale}>
          {dateLabel}
        </span>
      </div>
      <h1 class="newsprint-masthead">{masthead}</h1>
      {subkicker && subkicker.length > 0 && (
        <div class="newsprint-subkicker">
          {subkicker.map((item) => <span>{item}</span>)}
        </div>
      )}
    </header>
  )}
  <script is:inline nonce={nonce}>
    function updateNewsprintLocalDates(root) {
      var scope = root && root.querySelectorAll ? root : document;
      scope.querySelectorAll('[data-local-date]').forEach(function(node) {
        var iso = node.getAttribute('data-date-iso');
        var locale = node.getAttribute('data-date-locale') || document.documentElement.lang || 'en-US';
        if (!iso) return;
        node.textContent = new Date(iso).toLocaleDateString(locale, {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });
      });
    }

    updateNewsprintLocalDates(document);
    document.addEventListener('astro:after-swap', function() {
      updateNewsprintLocalDates(document);
    });
  </script>

  <div class={`newsprint-grid${rail ? '' : ' newsprint-grid--full'}`}>
    <div class={`newsprint-main${compact ? ' newsprint-main--article' : ''}`}>
      <slot />
    </div>
    {rail && (
      <aside class="newsprint-rail">
        <slot name="rail" />
      </aside>
    )}
  </div>
</section>

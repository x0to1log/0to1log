---
export const prerender = false;

import MainLayout from '../../../layouts/MainLayout.astro';
import { t } from '../../../i18n/index';
import { getProductsPageData } from '../../../lib/pageData/productsPage';
import ProductFilterBar from '../../../components/products/ProductFilterBar.astro';
import ProductCategoryTile from '../../../components/products/ProductCategoryTile.astro';
import ProductCard from '../../../components/products/ProductCard.astro';

const locale = 'ko';
const { categories, allProducts, productsByCategory, error } = await getProductsPageData(locale);

// Fixed 3 / 3 / 3 / 1 grid order. Categories render in this order regardless
// of the order the data layer returns them in.
const CATEGORY_ORDER = [
  'assistant', 'image', 'video',
  'audio', 'coding', 'workflow',
  'builder', 'platform', 'research',
  'community',
];
const orderedCategories = [...categories].sort(
  (a, b) => CATEGORY_ORDER.indexOf(a.id) - CATEGORY_ORDER.indexOf(b.id),
);

const pricingKo: Record<string, string> = { free: '무료', freemium: '무료 프리미엄', paid: '유료', enterprise: '기업용' };
const categoryKo: Record<string, string> = { assistant: '어시스턴트 챗봇', image: '이미지 디자인', video: '영상 비디오', audio: '오디오 음악 음성', coding: '코딩 개발 IDE', workflow: '자동화 워크플로우', builder: '앱빌더 노코드', platform: '플랫폼 API', research: '리서치 논문', community: '커뮤니티' };

const buildSearchText = (product: typeof allProducts[0]) =>
  [
    product.name,
    (product as any).name_ko,
    product.tagline,
    (product as any).tagline_ko,
    product.pricing,
    product.pricing ? pricingKo[product.pricing] : null,
    product.primary_category,
    categoryKo[product.primary_category],
    ...(product.platform ?? []),
    ...(product.tags ?? []),
    (product as any).search_corpus,
  ].filter(Boolean).join(' ').toLowerCase();

const getFirstImageUrl = (product: typeof allProducts[0]) => {
  const first = product.demo_media?.find((m) => m.type === 'image');
  return first?.url ?? null;
};
---

<MainLayout
  title={t.ko['products.title']}
  description={t.ko['products.heroSubtitle']}
  locale={locale}
  slug="products/"
>
  <div class="products-page" id="products-top">
    {error && <p class="products-error">{t.ko['products.error']}</p>}

    <ProductFilterBar locale={locale} />

    <button id="products-back-all" class="products-back-all" type="button" hidden>
      &larr; 모든 카테고리
    </button>

    <!-- Category Grid (3 / 3 / 3 / 1 tiles, each tile scrolls its products) -->
    <div class="product-category-grid" id="category-preview">
      {orderedCategories.map((cat) => (
        <ProductCategoryTile
          categoryId={cat.id}
          label={cat.label_ko}
          products={productsByCategory[cat.id] ?? []}
          locale={locale}
        />
      ))}
    </div>

    <!-- Filtered Grid Mode (when category or search active) -->
    <div class="product-grid" id="filtered-grid" hidden>
      {allProducts.map((product) => (
        <ProductCard
          href={`/${locale}/products/${product.slug}/`}
          name={product.name}
          tagline={product.tagline}
          logoUrl={product.logo_url}
          thumbnailUrl={product.thumbnail_url}
          demoMediaFirst={getFirstImageUrl(product)}
          pricing={product.pricing}
          platform={product.platform}
          koreanSupport={product.korean_support}
          locale={locale}
          searchText={buildSearchText(product)}
          categoryId={product.primary_category}
          secondaryCategories={product.secondary_categories}
          viewCount={product.view_count}
          productId={product.id}
        />
      ))}
    </div>

    <p id="product-search-no-results" class="products-search-no-results" hidden>
      {t.ko['products.searchNoResults']}
    </p>

    {allProducts.length === 0 && !error && (
      <p class="products-empty">{t.ko['products.empty']}</p>
    )}

    <section class="product-outro">
      <h2 class="product-outro-title">{t.ko['products.outroTitle']}</h2>
      <p class="product-outro-body">{t.ko['products.outroBody']}</p>
    </section>

    <p class="products-trademark-disclaimer">
      제품명, 로고 및 상표는 각 소유자의 자산입니다. 별도 표기가 없는 한, 0to1log는 나열된 회사와 제휴, 보증 또는 후원 관계가 없습니다.
    </p>
  </div>
</MainLayout>

<script>
  import '../../../scripts/handbookSearchHints';
  import '../../../scripts/productLike';

  document.addEventListener('astro:page-load', () => {
    const input = document.getElementById('product-search') as HTMLInputElement | null;
    if (!input) return;
    const noResults = document.getElementById('product-search-no-results');
    const grid = document.getElementById('category-preview');
    const filtered = document.getElementById('filtered-grid');
    const backBtn = document.getElementById('products-back-all');
    const cards = filtered ? Array.from(filtered.querySelectorAll<HTMLElement>('.product-card')) : [];

    let currentCategory = 'all';
    let currentQuery = '';

    function switchToFiltered(cat: string) {
      currentCategory = cat;
      if (grid) grid.hidden = true;
      if (filtered) filtered.hidden = false;
      if (backBtn) backBtn.hidden = false;
      applyFilters();
    }

    function switchToPreview() {
      currentCategory = 'all';
      currentQuery = '';
      if (input) input.value = '';
      if (grid) grid.hidden = false;
      if (filtered) filtered.hidden = true;
      if (backBtn) backBtn.hidden = true;
      if (noResults) noResults.hidden = true;

      history.replaceState(null, '', location.pathname);
    }

    function applyFilters() {
      const q = currentQuery.trim().toLowerCase();
      let totalVisible = 0;

      cards.forEach((card) => {
        const text = card.dataset.searchText ?? '';
        const cat = card.dataset.category ?? '';
        const secondaryStr = card.dataset.secondaryCategories ?? '';
        const secondary = secondaryStr ? secondaryStr.split(',').filter(Boolean) : [];

        const matchesCategory =
          currentCategory === 'all' ||
          cat === currentCategory ||
          secondary.includes(currentCategory);
        const matchesSearch = !q || text.includes(q);
        const visible = matchesCategory && matchesSearch;

        if (visible) { card.removeAttribute('hidden'); totalVisible++; }
        else card.setAttribute('hidden', '');
      });

      if (noResults) {
        if (totalVisible === 0 && (q || currentCategory !== 'all')) noResults.removeAttribute('hidden');
        else noResults.setAttribute('hidden', '');
      }
    }

    input.addEventListener('input', () => {
      currentQuery = input.value;
      const url = new URL(window.location.href);
      if (currentQuery) {
        url.searchParams.set('q', currentQuery);
        url.searchParams.delete('cat');
        currentCategory = 'all';
        if (grid) grid.hidden = true;
        if (filtered) filtered.hidden = false;
        if (backBtn) backBtn.hidden = false;
      } else if (currentCategory === 'all') {
        url.searchParams.delete('q');
        switchToPreview();
        return;
      } else {
        url.searchParams.delete('q');
      }
      history.replaceState(null, '', url.toString());
      applyFilters();
    });

    // "← 모든 카테고리" — return to the category grid
    backBtn?.addEventListener('click', () => switchToPreview());

    // Category tile header → open that category's filtered view
    document.querySelectorAll<HTMLButtonElement>('.product-cat-tile-header').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.category ?? '';
        const url = new URL(window.location.href);
        url.searchParams.set('cat', cat);
        history.replaceState(null, '', url.toString());
        switchToFiltered(cat);
        document.getElementById('products-top')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    // Product #hashtag → search for that tag (without following the row link)
    document.querySelectorAll<HTMLElement>('.product-cat-tag').forEach((tag) => {
      const trigger = (e: Event) => {
        e.preventDefault();
        e.stopPropagation();
        const term = tag.dataset.tag ?? '';
        if (!term) return;
        input.value = term;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        document.getElementById('products-top')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };
      tag.addEventListener('click', trigger);
      tag.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        if (k === 'Enter' || k === ' ') trigger(e);
      });
    });

    const params = new URLSearchParams(location.search);
    const urlQ = params.get('q') ?? '';
    const urlCat = params.get('cat') ?? '';
    if (urlQ) {
      input.value = urlQ;
      currentQuery = urlQ;
      switchToFiltered(urlCat || 'all');
    } else if (urlCat) {
      switchToFiltered(urlCat);
    }
  });
</script>
